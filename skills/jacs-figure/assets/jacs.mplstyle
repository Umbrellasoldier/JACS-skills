# Project defaults, not a journal-wide empirical style or an ACS requirement.
font.family: sans-serif
font.sans-serif: Liberation Sans, DejaVu Sans, Arial, Helvetica
font.size: 8
axes.labelsize: 8
axes.titlesize: 8
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
axes.linewidth: 0.7
lines.linewidth: 1.1
xtick.major.width: 0.7
ytick.major.width: 0.7
axes.spines.top: False
axes.spines.right: False
xtick.direction: out
ytick.direction: out
legend.frameon: False
figure.facecolor: white
axes.facecolor: white
savefig.facecolor: white
svg.fonttype: none
pdf.fonttype: 42
ps.fonttype: 42
